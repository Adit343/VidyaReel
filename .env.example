# Include a database name in the path, e.g. mongodb+srv://user:pw@host/vidyareel?appName=x
MONGODB_URI=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
ELEVENLABS_API_KEY=
# Comma-separated, no spaces: id1,id2
ELEVENLABS_VOICE_IDS=
ELEVENLABS_MONTHLY_CREDITS=
PEXELS_API_KEY=
PIXABAY_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Instagram login: META_APP_ID/SECRET are the Instagram app id and secret (App dashboard > Instagram > API setup with Instagram login).
# META_REDIRECT_URI must be listed as a valid OAuth redirect URI there; empty means APP_URL + /api/instagram/callback.
# IG_TOKEN_KEY: 32 random bytes as 64 hex characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# IG_ALLOWED_ACCOUNT_TYPES: default BUSINESS,CREATOR.
IG_TOKEN_KEY=
IG_ALLOWED_ACCOUNT_TYPES=
