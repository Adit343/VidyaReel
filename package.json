  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "remotion bundle src/remotion/index.ts --out-dir=build/remotion-bundle && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
