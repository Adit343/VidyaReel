    "mongodb": "^6.8.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
