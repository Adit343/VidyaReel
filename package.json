    "check:render": "tsx scripts/check-render.mts",
    "spike:voice": "tsx scripts/spike-voice-sync.mts",
    "check:voice-samples": "tsx scripts/check-voice-samples.mts",
    "upload:music": "tsx scripts/upload-music.mts",
    "check:media": "tsx scripts/check-media.mts",
    "check:storyboards": "tsx scripts/check-storyboards.mts",
    "check:mobile": "tsx scripts/mobile-check.mts",
    "ui:harness": "tsx scripts/ui-harness.mts",
    "spike:instagram": "tsx scripts/spike-instagram.mts",
    "spike:sandbox": "tsx scripts/spike-sandbox-render.mts",
    "remotion:render": "remotion render src/remotion/index.ts Video out/spike.mp4 --port=3100",
